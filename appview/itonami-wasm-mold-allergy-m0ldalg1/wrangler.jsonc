// svelte -> cljs migration (2026-09-07, ADR-2608260900):
//   - "main" removed. It pointed at the deleted SvelteKit build output
//     (svelte/.svelte-kit/cloudflare/_worker.js). This surface is now a
//     static-assets-only deploy served straight out of `assets.directory`.
//   - "assets.directory" now points at the cljs build output (./cljs/public).
//   - "main" is intentionally NOT repointed at "src/app.ts": that Worker's
//     fetch handler does not call env.ASSETS.fetch(), so putting it in
//     front of the assets binding would mean nothing serves the static
//     files any more. src/app.ts remains a separate XRPC/health facade
//     that this config does not wire as the assets-serving entry point.
//   - vars.APP_FRAMEWORK updated to reflect the new frontend stack.
// UNVERIFIED: no `wrangler deploy` / `wrangler dev` was run against this
// config as part of this migration.
{
  "name": "kotodama-m0ldalg1",
  "compatibility_date": "2025-03-17",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_als"
  ],
  "vars": {
    "APP_CAPABILITIES": "[\"bpmn-dispatch\",\"allergen-characterization\",\"epidemiology-query\",\"slit-formulation-design\",\"clinical-trial-protocol-drafting\",\"literature-mining\"]",
    "APP_DESCRIPTION": "Mold-Allergy research agent. Fungal allergen catalog, air sampling, and SLIT candidate workflows run in BPMN + Zeebe Python.",
    "APP_DISPLAY_NAME": "Mold-Allergy",
    "APP_EMBED_URL": "https://m0ldalg1.itonami.cloud/?embed=1",
    "APP_FRAMEWORK": "cljs-reagent-re-frame-jp-go-dds",
    "APP_NANOID": "m0ldalg1",
    "APP_PERFORMER_TYPE": "service",
    "APP_SOURCE": "custom",
    "APP_TEMPLATE": "",
    "APP_UI_TYPE": "appview",
    "APP_VERSION": "0.1.0",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.itonami.cloud/xrpc/cloud.itonami.mcp.message"
  },
  "routes": [
    {
      "pattern": "mold-allergy.itonami.cloud/*",
      "zone_name": "itonami.cloud"
    }
  ],
  "assets": {
    "directory": "./cljs/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
